// cagent 资源: 应用图标 + 版本信息
#include "core/version.h"

1 ICON "app.ico"

// 版本资源: 右键 cagent.exe -> 属性 -> 详细信息 可见
// 数值与 core/version.h 保持一致 (由宏引用, 不硬编码)
// 注意: 资源名必须用整数 1 (即 VS_VERSION_INFO 在 winver.h 中的值),
// 直接写 "VS_VERSION_INFO" 会被 windres 当成字符串名, 导致 GetFileVersionInfo 报 1813。
1 VERSIONINFO
 FILEVERSION    CAGENT_VER_MAJOR, CAGENT_VER_MINOR, CAGENT_VER_PATCH, CAGENT_VER_BUILD
 PRODUCTVERSION CAGENT_VER_MAJOR, CAGENT_VER_MINOR, CAGENT_VER_PATCH, CAGENT_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEOS         0x40004L   /* VOS__WINDOWS32 */
 FILETYPE       0x1L       /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"    /* 0x0804=简体中文, 1200=Unicode */
        BEGIN
            VALUE "FileDescription", "cagent - C 语言极简编程 Agent"
            VALUE "FileVersion", CAGENT_VERSION_STR
            VALUE "ProductName", "cagent"
            VALUE "ProductVersion", CAGENT_VERSION_STR
            VALUE "InternalName", "cagent"
            VALUE "OriginalFilename", "cagent.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
