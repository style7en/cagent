# 构建产物 (源码在 src/, 资源在 res/; 产物按"exe 目录=数据根"的约定留在仓库根)
# 注意: 这里只忽略 *.res 文件, 不影响 res/ 目录本身 —— 它是要入库的。
*.exe
*.o
*.obj
*.res

# 输出区排版预览产物 (make preview 生成, 供人眼检查配色/缩进/段间距/折叠)
preview_out.bmp
preview_out.png
preview_folded.bmp
preview_folded.png
preview_input.bmp
preview_input.png
preview_replay_session.json

# 运行时配置 (含 API Key, 严禁提交)
cagent.ini

# 对话历史 (运行时生成, 按工作目录分文件)
cagent_history.json
history_*.json
sessions/

# 运行日志与失败请求留档 (log=1 时生成)
log/

# 工作区数据 (记忆/日志, 非源码)
.workbuddy/
.workbuddy-ai/

# 编辑器/IDE
.vscode/
.idea/
*.swp
*~

# 外置系统提示词 (运行时本地文件, 同 cagent.ini)
SYSTEM_PROMPT

# 计划/设计文档 (superpowers 流程产物, 不入库)
docs/

# 代码审查报告 (本地生成, 与本机记忆同类, 不入库)
CODE_REVIEW.md
code-review.md
整体代码审查.md

# E2E UI 测试运行物证 (每次运行生成, 不入库)
test/e2e_artifacts/

# UT 测试隔离工作区 (make test 运行时生成; 正常跑完会自己清掉, 这条只是兜底)
cagent_test_ws/

# UI 排查探针 (本地验证工具: 间隙/光标/闪烁三套 + cue_probe 的 manifest/rc 配套,
# 是历次渲染/折叠/滚动修复的取证程序; 留在本机但不入库 —— 仓库里不留"构建外的代码")
test/ui_gap_probe.c
test/ui_cue_probe.c
test/ui_flicker_probe.c
test/ui_input_flicker_probe.c
test/ui_hist_flicker_probe.c
test/ui_dpi_style_probe.c
test/ui_glyph_probe.c
test/ui_userbg_probe.c
test/cue_probe.manifest
test/cue_probe.rc

# ui_*_probe 的取证 BMP/PNG (探针产物, 不入库)
glyph_*.bmp
glyph_*.png
userbg_*.bmp
userbg_*.png

# test/ 源码的产物目录 (回归/mdtest/preview/探针的 exe 与临时 BMP/JSON)
test/out/
